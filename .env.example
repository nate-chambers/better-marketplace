# Keep this token on the server. Browsing, importing, and demo mode work without it.
APIFY_TOKEN=

# Resolved relative to the directory where you start the app.
MARKETPLACE_DATA_DIR=data
MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=8768

# Upper bounds enforced by the server. The run dialog can request less.
MARKETPLACE_MAX_RUN_USD=10
MARKETPLACE_MAX_JOB_USD=0.25
MARKETPLACE_MAX_JOBS=40

# Comma-separated browser origins allowed to change data, no trailing slash.
# Add your exact Tailscale URL here if you proxy this server through Tailscale Serve.
MARKETPLACE_ALLOWED_ORIGINS=http://127.0.0.1:8768,http://localhost:8768
